# ============================================================================
# KHUNDET NOBILIS LLC — Server-Side B2B Inquiry Environment Variables
# Copy this file to .env.local for local testing or configure in Vercel Dashboard
# (Project Settings -> Environment Variables).
# NEVER commit your actual RESEND_API_KEY to Git.
# ============================================================================

# Required in Production: Resend API Key (starts with re_...)
RESEND_API_KEY=

# Optional Override: Verified recipient inbox (defaults to erkhemsaikhan@khundet-nobilis.mn)
INQUIRY_TO_EMAIL=erkhemsaikhan@khundet-nobilis.mn

# Optional Override: Verified sender address on khundet-nobilis.mn domain in Resend
INQUIRY_FROM_EMAIL="Khundet Nobilis B2B Desk <inquiries@khundet-nobilis.mn>"

# Local Integration Test Only: Set to "true" ONLY when running local automated tests without a live Resend key
INQUIRY_MOCK_MODE=false
